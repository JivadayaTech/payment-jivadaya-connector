# ==============================================================================
# payment.jivadaya.org - Production .env Credentials File
# ==============================================================================
# Copy and rename this file to `.env` on your payment.jivadaya.org server,
# then replace the placeholder values below with your real live credentials.
# ==============================================================================

# Server Settings
PORT=4000
NODE_ENV=production
APP_URL=https://payment.jivadaya.org
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# CCAVENUE CREDENTIALS (Fixes Error 10002)
# ------------------------------------------------------------------------------
CCAVENUE_ENV=live
CCAVENUE_INITIATE_URL=https://secure.ccavenue.com/transaction/transaction.do?command=initiateTransaction

# Replace with your actual credentials from CCAvenue Dashboard:
CCAVENUE_MERCHANT_ID=YOUR_LIVE_CCAVENUE_MERCHANT_ID
CCAVENUE_ACCESS_CODE=YOUR_LIVE_CCAVENUE_ACCESS_CODE
CCAVENUE_WORKING_KEY=YOUR_LIVE_CCAVENUE_WORKING_KEY

# ------------------------------------------------------------------------------
# RAZORPAY CREDENTIALS
# ------------------------------------------------------------------------------
# Replace with your actual credentials from Razorpay Dashboard:
RAZORPAY_KEY_ID=YOUR_LIVE_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_RAZORPAY_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# CALLBACKS & SECURITY
# ------------------------------------------------------------------------------
DEFAULT_CALLBACK_URL=https://payment.jivadaya.org/thank-you
S2S_WEBHOOK_SECRET=change_this_to_a_secure_random_string_123
